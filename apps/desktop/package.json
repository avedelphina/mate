{
  "name": "mate-desktop",
  "version": "0.8.0",
  "description": "A desk for a body of work: review markdown in place, with agents that propose and you decide.",
  "author": "Tomas Kracmar",
  "homepage": "https://github.com/avedelphina/mate#readme",
  "desktopName": "io.github.avedelphina.mate",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:assist": "swiftc -O -target arm64-apple-macosx26.0 assist/main.swift -o assist/mate-assist",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test tests/*.test.ts",
    "test:e2e": "electron-vite build && node --experimental-strip-types --import ./tests/register.mjs --test tests/e2e/*.e2e.ts",
    "icon": "electron build/icon.mjs",
    "pack:mac": "pnpm build:assist && electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "dist:mac": "pnpm build:assist && electron-vite build && electron-builder --mac --arm64",
    "pack:linux": "electron-vite build && electron-builder --linux --x64 --dir",
    "dist:linux": "electron-vite build && electron-builder --linux --x64"
  },
  "devDependencies": {
    "@lezer/markdown": "^1.8.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}

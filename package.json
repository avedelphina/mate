{
  "name": "mate",
  "version": "0.11.1",
  "description": "A desk for a body of work: review markdown in place, with agents that propose and you decide.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avedelphina/mate.git"
  },
  "homepage": "https://github.com/avedelphina/mate#readme",
  "bugs": {
    "url": "https://github.com/avedelphina/mate/issues"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "test": "pnpm --dir apps/desktop test",
    "test:e2e": "pnpm --dir apps/desktop test:e2e",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "build": "pnpm --dir apps/desktop build",
    "build:assist": "pnpm --dir apps/desktop build:assist",
    "pack:mac": "pnpm --dir apps/desktop pack:mac",
    "dist:mac": "pnpm --dir apps/desktop dist:mac",
    "pack:linux": "pnpm --dir apps/desktop pack:linux",
    "dist:linux": "pnpm --dir apps/desktop dist:linux"
  }
}
